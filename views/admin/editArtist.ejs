<section class="admin-section">
  <div class="admin-header">
    <h1><i class="fas fa-edit"></i> Edit Artist</h1>
    <a href="/admin/artists" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back</a>
  </div>

  <form action="/admin/artists/edit/<%= artist._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="admin-form">
    <div class="form-group">
      <label for="name">Artist Name *</label>
      <input type="text" id="name" name="name" value="<%= artist.name %>" required>
    </div>

    <div class="form-group">
      <label for="bio">Bio</label>
      <textarea id="bio" name="bio" rows="4"><%= artist.bio %></textarea>
    </div>

    <div class="form-group">
      <label for="genres">Genres (comma-separated)</label>
      <input type="text" id="genres" name="genres" value="<%= artist.genres.join(', ') %>">
    </div>

    <div class="form-group">
      <label for="image">Replace Image (optional)</label>
      <div class="file-upload">
        <input type="file" id="image" name="image" accept="image/*">
        <div class="file-upload-label">
          <i class="fas fa-image"></i>
          <span>Choose new image</span>
        </div>
      </div>
      <% if (artist.image && !artist.image.includes('default')) { %>
        <img src="<%= artist.image %>" alt="<%= artist.name %>" class="form-preview-img form-preview-round">
      <% } %>
    </div>

    <button type="submit" class="btn btn-accent btn-lg">
      <i class="fas fa-save"></i> Save Changes
    </button>
  </form>
</section>
