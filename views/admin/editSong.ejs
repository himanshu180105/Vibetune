<section class="admin-section">
  <div class="admin-header">
    <h1><i class="fas fa-edit"></i> Edit Song</h1>
    <a href="/admin/songs" class="btn btn-ghost"><i class="fas fa-arrow-left"></i> Back</a>
  </div>

  <form action="/admin/songs/edit/<%= song._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="title">Song Title *</label>
        <input type="text" id="title" name="title" value="<%= song.title %>" required>
      </div>
      <div class="form-group">
        <label for="genre">Genre</label>
        <input type="text" id="genre" name="genre" value="<%= song.genre %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="artist">Artist *</label>
        <select id="artist" name="artist" required>
          <% artists.forEach(artist => { %>
            <option value="<%= artist._id %>" <%= song.artist && song.artist._id.toString() === artist._id.toString() ? 'selected' : '' %>><%= artist.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label for="album">Album</label>
        <select id="album" name="album">
          <option value="">No Album</option>
          <% albums.forEach(album => { %>
            <option value="<%= album._id %>" <%= song.album && song.album._id && song.album._id.toString() === album._id.toString() ? 'selected' : '' %>><%= album.title %></option>
          <% }); %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="duration">Duration (seconds)</label>
      <input type="number" id="duration" name="duration" value="<%= song.duration %>" min="0">
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="audio">Replace Audio File (optional)</label>
        <div class="file-upload">
          <input type="file" id="audio" name="audio" accept="audio/*">
          <div class="file-upload-label">
            <i class="fas fa-cloud-upload-alt"></i>
            <span>Choose new audio</span>
          </div>
        </div>
        <p class="form-help">Leave empty to keep current audio file.</p>
      </div>
      <div class="form-group">
        <label for="cover">Replace Cover Image (optional)</label>
        <div class="file-upload">
          <input type="file" id="cover" name="cover" accept="image/*">
          <div class="file-upload-label">
            <i class="fas fa-image"></i>
            <span>Choose new cover</span>
          </div>
        </div>
        <% if (song.coverUrl && !song.coverUrl.includes('default')) { %>
          <img src="<%= song.coverUrl %>" alt="Current cover" class="form-preview-img">
        <% } %>
      </div>
    </div>

    <button type="submit" class="btn btn-accent btn-lg">
      <i class="fas fa-save"></i> Save Changes
    </button>
  </form>
</section>
