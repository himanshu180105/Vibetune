<section class="admin-section">
  <div class="admin-header">
    <h1><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h1>
  </div>

  <!-- Stats Cards -->
  <div class="admin-stats-grid">
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: linear-gradient(135deg, #1DB954, #1ed760);">
        <i class="fas fa-music"></i>
      </div>
      <div class="admin-stat-info">
        <h3><%= songCount %></h3>
        <p>Songs</p>
      </div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: linear-gradient(135deg, #8400E7, #b44dff);">
        <i class="fas fa-microphone-alt"></i>
      </div>
      <div class="admin-stat-info">
        <h3><%= artistCount %></h3>
        <p>Artists</p>
      </div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: linear-gradient(135deg, #E13300, #ff6b3d);">
        <i class="fas fa-compact-disc"></i>
      </div>
      <div class="admin-stat-info">
        <h3><%= albumCount %></h3>
        <p>Albums</p>
      </div>
    </div>
    <div class="admin-stat-card">
      <div class="admin-stat-icon" style="background: linear-gradient(135deg, #0D73EC, #5ba3f5);">
        <i class="fas fa-users"></i>
      </div>
      <div class="admin-stat-info">
        <h3><%= userCount %></h3>
        <p>Users</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="admin-actions">
    <h2>Quick Actions</h2>
    <div class="admin-actions-grid">
      <a href="/admin/songs/add" class="admin-action-card">
        <i class="fas fa-plus-circle"></i>
        <span>Add Song</span>
      </a>
      <a href="/admin/artists/add" class="admin-action-card">
        <i class="fas fa-user-plus"></i>
        <span>Add Artist</span>
      </a>
      <a href="/admin/albums/add" class="admin-action-card">
        <i class="fas fa-folder-plus"></i>
        <span>Add Album</span>
      </a>
      <a href="/admin/songs" class="admin-action-card">
        <i class="fas fa-list"></i>
        <span>Manage Songs</span>
      </a>
      <a href="/admin/artists" class="admin-action-card">
        <i class="fas fa-users-cog"></i>
        <span>Manage Artists</span>
      </a>
      <a href="/admin/albums" class="admin-action-card">
        <i class="fas fa-cog"></i>
        <span>Manage Albums</span>
      </a>
    </div>
  </div>
</section>
