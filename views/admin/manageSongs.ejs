<section class="admin-section">
  <div class="admin-header">
    <h1><i class="fas fa-music"></i> Manage Songs</h1>
    <a href="/admin/songs/add" class="btn btn-accent"><i class="fas fa-plus"></i> Add Song</a>
  </div>

  <% if (songs.length > 0) { %>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Cover</th>
            <th>Title</th>
            <th>Artist</th>
            <th>Genre</th>
            <th>Duration</th>
            <th>Plays</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% songs.forEach(song => { %>
            <tr>
              <td>
                <img src="<%= song.coverUrl %>" alt="<%= song.title %>" class="admin-table-cover">
              </td>
              <td><strong><%= song.title %></strong></td>
              <td><%= song.artist ? song.artist.name : 'Unknown' %></td>
              <td><span class="badge"><%= song.genre %></span></td>
              <td><%= song.formattedDuration %></td>
              <td><%= song.plays %></td>
              <td class="admin-table-actions">
                <a href="/admin/songs/edit/<%= song._id %>" class="btn btn-sm btn-outline" title="Edit">
                  <i class="fas fa-edit"></i>
                </a>
                <form action="/admin/songs/<%= song._id %>?_method=DELETE" method="POST" class="inline-form"
                      onsubmit="return confirm('Delete this song?')">
                  <button type="submit" class="btn btn-sm btn-danger" title="Delete">
                    <i class="fas fa-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-music"></i>
      <h2>No songs yet</h2>
      <a href="/admin/songs/add" class="btn btn-accent">Add Your First Song</a>
    </div>
  <% } %>
</section>
