<section class="admin-section">
  <div class="admin-header">
    <h1><i class="fas fa-microphone-alt"></i> Manage Artists</h1>
    <a href="/admin/artists/add" class="btn btn-accent"><i class="fas fa-plus"></i> Add Artist</a>
  </div>

  <% if (artists.length > 0) { %>
    <div class="admin-table-wrapper">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Genres</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% artists.forEach(artist => { %>
            <tr>
              <td><img src="<%= artist.image %>" alt="<%= artist.name %>" class="admin-table-avatar"></td>
              <td><strong><%= artist.name %></strong></td>
              <td><%= artist.genres.join(', ') || '—' %></td>
              <td class="admin-table-actions">
                <a href="/admin/artists/edit/<%= artist._id %>" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i></a>
                <form action="/admin/artists/<%= artist._id %>?_method=DELETE" method="POST" class="inline-form"
                      onsubmit="return confirm('Delete this artist?')">
                  <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-microphone-alt"></i>
      <h2>No artists yet</h2>
      <a href="/admin/artists/add" class="btn btn-accent">Add Your First Artist</a>
    </div>
  <% } %>
</section>
