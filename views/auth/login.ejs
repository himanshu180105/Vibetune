<div class="auth-page">
  <div class="auth-container">
    <div class="auth-logo">
      <i class="fas fa-compact-disc"></i>
      <h1>VibeTune</h1>
    </div>

    <div class="auth-card">
      <h2>Log in to VibeTune</h2>

      <form action="/auth/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" placeholder="name@example.com" required autocomplete="email">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Password" required autocomplete="current-password">
        </div>

        <button type="submit" class="btn btn-accent btn-full btn-lg">Log In</button>
      </form>

      <div class="auth-divider">
        <span>Don't have an account?</span>
      </div>

      <a href="/auth/register" class="btn btn-outline btn-full">Sign Up for VibeTune</a>
    </div>
  </div>
</div>
