<section class="detail-page artist-page">
  <div class="artist-hero">
    <div class="artist-hero-bg" style="background-image: url('<%= artist.image %>')"></div>
    <div class="artist-hero-content">
      <div class="artist-hero-image">
        <img src="<%= artist.image %>" alt="<%= artist.name %>">
      </div>
      <div class="artist-hero-info">
        <span class="detail-type">Artist</span>
        <h1><%= artist.name %></h1>
        <% if (artist.genres.length > 0) { %>
          <p class="artist-genres"><%= artist.genres.join(', ') %></p>
        <% } %>
      </div>
    </div>
  </div>

  <% if (artist.bio) { %>
    <div class="artist-bio">
      <h3>About</h3>
      <p><%= artist.bio %></p>
    </div>
  <% } %>

  <!-- Popular Songs -->
  <% if (songs.length > 0) { %>
    <section class="content-section">
      <h2>Popular</h2>
      <div class="song-list">
        <% songs.forEach((song, index) => { %>
          <div class="song-row"
               data-song-id="<%= song._id %>"
               data-song-title="<%= song.title %>"
               data-song-artist="<%= artist.name %>"
               data-song-artist-id="<%= artist._id %>"
               data-song-cover="<%= song.coverUrl %>"
               data-song-audio="<%= song.audioUrl %>"
               data-song-duration="<%= song.duration %>"
          >
            <span class="song-row-index"><%= index + 1 %></span>
            <div class="song-row-cover">
              <img src="<%= song.coverUrl %>" alt="<%= song.title %>" loading="lazy">
              <button class="song-row-play play-btn-trigger"><i class="fas fa-play"></i></button>
            </div>
            <div class="song-row-info">
              <p class="song-row-title"><a href="/songs/<%= song._id %>"><%= song.title %></a></p>
              <p class="song-row-artist"><%= artist.name %></p>
            </div>
            <span class="song-row-plays"><%= song.plays.toLocaleString() %> plays</span>
            <span class="song-row-duration"><%= song.formattedDuration %></span>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <!-- Discography -->
  <% if (albums.length > 0) { %>
    <section class="content-section">
      <h2>Discography</h2>
      <div class="card-grid">
        <% albums.forEach(album => { %>
          <a href="/albums/<%= album._id %>" class="album-card">
            <div class="album-card-cover">
              <img src="<%= album.coverUrl %>" alt="<%= album.title %>" loading="lazy">
            </div>
            <h4><%= album.title %></h4>
            <p><%= album.releaseYear %> · Album</p>
          </a>
        <% }); %>
      </div>
    </section>
  <% } %>
</section>
