<!-- Hero Section -->
<section class="hero-section">
  <div class="hero-content">
    <h1>Listen Without Limits</h1>
    <p>Discover new music, create playlists, and enjoy your favorite tunes.</p>
    <% if (!currentUser) { %>
      <a href="/auth/register" class="btn btn-accent btn-lg">Get Started Free</a>
    <% } %>
  </div>
</section>

<!-- Recently Added -->
<% if (recentSongs.length > 0) { %>
<section class="content-section">
  <div class="section-header">
    <h2>Recently Added</h2>
  </div>
  <div class="card-grid">
    <% recentSongs.forEach(song => { %>
      <%- include('../partials/songCard', { song }) %>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Popular Songs -->
<% if (popularSongs.length > 0) { %>
<section class="content-section">
  <div class="section-header">
    <h2>Popular Right Now</h2>
  </div>
  <div class="card-grid">
    <% popularSongs.forEach(song => { %>
      <%- include('../partials/songCard', { song }) %>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Browse by Genre -->
<% if (genres.length > 0) { %>
<section class="content-section">
  <div class="section-header">
    <h2>Browse by Genre</h2>
  </div>
  <div class="genre-grid">
    <% const genreColors = ['#E13300', '#8400E7', '#1E3264', '#E8115B', '#148A08', '#E1118B', '#BC5900', '#608108', '#503750', '#0D73EC']; %>
    <% genres.forEach((genre, index) => { %>
      <a href="/browse?genre=<%= encodeURIComponent(genre) %>" class="genre-card" style="background: <%= genreColors[index % genreColors.length] %>;">
        <h3><%= genre %></h3>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Featured Artists -->
<% if (artists.length > 0) { %>
<section class="content-section">
  <div class="section-header">
    <h2>Featured Artists</h2>
  </div>
  <div class="card-grid">
    <% artists.forEach(artist => { %>
      <a href="/artists/<%= artist._id %>" class="artist-card">
        <div class="artist-card-image">
          <img src="<%= artist.image %>" alt="<%= artist.name %>" loading="lazy">
        </div>
        <h4><%= artist.name %></h4>
        <p>Artist</p>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Featured Albums -->
<% if (albums.length > 0) { %>
<section class="content-section">
  <div class="section-header">
    <h2>Featured Albums</h2>
  </div>
  <div class="card-grid">
    <% albums.forEach(album => { %>
      <a href="/albums/<%= album._id %>" class="album-card">
        <div class="album-card-cover">
          <img src="<%= album.coverUrl %>" alt="<%= album.title %>" loading="lazy">
        </div>
        <h4><%= album.title %></h4>
        <p><%= album.artist ? album.artist.name : 'Unknown' %> · <%= album.releaseYear %></p>
      </a>
    <% }); %>
  </div>
</section>
<% } %>

<!-- Empty State -->
<% if (recentSongs.length === 0 && popularSongs.length === 0) { %>
<section class="empty-state">
  <i class="fas fa-music"></i>
  <h2>No music yet</h2>
  <p>Songs will appear here once added by an admin.</p>
  <% if (currentUser && currentUser.role === 'admin') { %>
    <a href="/admin/songs/add" class="btn btn-accent">Add Your First Song</a>
  <% } %>
</section>
<% } %>
