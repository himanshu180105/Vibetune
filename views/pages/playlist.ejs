<section class="detail-page playlist-page">
  <div class="detail-hero">
    <div class="detail-cover playlist-cover">
      <% if (playlist.songs && playlist.songs.length > 0 && playlist.songs[0].coverUrl) { %>
        <img src="<%= playlist.songs[0].coverUrl %>" alt="<%= playlist.name %>">
      <% } else { %>
        <div class="playlist-cover-placeholder">
          <i class="fas fa-music"></i>
        </div>
      <% } %>
    </div>
    <div class="detail-info">
      <span class="detail-type">Playlist</span>
      <h1><%= playlist.name %></h1>
      <% if (playlist.description) { %>
        <p class="playlist-description"><%= playlist.description %></p>
      <% } %>
      <div class="detail-meta">
        <strong><%= playlist.user ? playlist.user.name : 'Unknown' %></strong>
        <span class="detail-dot">·</span>
        <span><%= playlist.songs ? playlist.songs.length : 0 %> songs</span>
        <% if (!playlist.isPublic) { %>
          <span class="detail-dot">·</span>
          <span class="badge badge-private"><i class="fas fa-lock"></i> Private</span>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <% if (isOwner) { %>
    <div class="detail-actions">
      <form action="/playlists/<%= playlist._id %>?_method=DELETE" method="POST" class="inline-form"
            onsubmit="return confirm('Are you sure you want to delete this playlist?')">
        <button type="submit" class="btn btn-ghost btn-danger">
          <i class="fas fa-trash"></i> Delete Playlist
        </button>
      </form>
    </div>
  <% } %>

  <!-- Song List -->
  <% if (playlist.songs && playlist.songs.length > 0) { %>
    <div class="song-list">
      <div class="song-list-header">
        <span class="song-list-header-index">#</span>
        <span class="song-list-header-title">Title</span>
        <span class="song-list-header-duration"><i class="far fa-clock"></i></span>
      </div>
      <% playlist.songs.forEach((song, index) => { %>
        <div class="song-row"
             data-song-id="<%= song._id %>"
             data-song-title="<%= song.title %>"
             data-song-artist="<%= song.artist ? song.artist.name : 'Unknown' %>"
             data-song-artist-id="<%= song.artist ? song.artist._id : '' %>"
             data-song-cover="<%= song.coverUrl %>"
             data-song-audio="<%= song.audioUrl %>"
             data-song-duration="<%= song.duration %>"
        >
          <span class="song-row-index"><%= index + 1 %></span>
          <div class="song-row-cover">
            <img src="<%= song.coverUrl %>" alt="<%= song.title %>" loading="lazy">
            <button class="song-row-play play-btn-trigger"><i class="fas fa-play"></i></button>
          </div>
          <div class="song-row-info">
            <p class="song-row-title"><a href="/songs/<%= song._id %>"><%= song.title %></a></p>
            <p class="song-row-artist">
              <% if (song.artist) { %>
                <a href="/artists/<%= song.artist._id %>"><%= song.artist.name %></a>
              <% } %>
            </p>
          </div>
          <% if (isOwner) { %>
            <form action="/playlists/<%= playlist._id %>/songs/<%= song._id %>?_method=DELETE" method="POST" class="inline-form">
              <button type="submit" class="btn btn-icon btn-ghost" title="Remove from playlist">
                <i class="fas fa-times"></i>
              </button>
            </form>
          <% } %>
          <span class="song-row-duration"><%= song.formattedDuration %></span>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="fas fa-music"></i>
      <h2>It's a bit empty here</h2>
      <p>Find some songs to add to your playlist.</p>
      <a href="/" class="btn btn-accent">Find Songs</a>
    </div>
  <% } %>
</section>
