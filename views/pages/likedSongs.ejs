<section class="detail-page liked-page">
  <div class="detail-hero liked-hero">
    <div class="liked-hero-bg"></div>
    <div class="detail-info">
      <span class="detail-type">Playlist</span>
      <h1>Liked Songs</h1>
      <p><%= currentUser.name %> · <%= likedSongs.length %> song<%= likedSongs.length !== 1 ? 's' : '' %></p>
    </div>
  </div>

  <% if (likedSongs.length > 0) { %>
    <div class="song-list">
      <div class="song-list-header">
        <span class="song-list-header-index">#</span>
        <span class="song-list-header-title">Title</span>
        <span class="song-list-header-duration"><i class="far fa-clock"></i></span>
      </div>
      <% likedSongs.forEach((song, index) => { %>
        <div class="song-row"
             data-song-id="<%= song._id %>"
             data-song-title="<%= song.title %>"
             data-song-artist="<%= song.artist ? song.artist.name : 'Unknown' %>"
             data-song-artist-id="<%= song.artist ? song.artist._id : '' %>"
             data-song-cover="<%= song.coverUrl %>"
             data-song-audio="<%= song.audioUrl %>"
             data-song-duration="<%= song.duration %>"
        >
          <span class="song-row-index"><%= index + 1 %></span>
          <div class="song-row-cover">
            <img src="<%= song.coverUrl %>" alt="<%= song.title %>" loading="lazy">
            <button class="song-row-play play-btn-trigger"><i class="fas fa-play"></i></button>
          </div>
          <div class="song-row-info">
            <p class="song-row-title"><a href="/songs/<%= song._id %>"><%= song.title %></a></p>
            <p class="song-row-artist">
              <% if (song.artist) { %>
                <a href="/artists/<%= song.artist._id %>"><%= song.artist.name %></a>
              <% } %>
            </p>
          </div>
          <button class="btn btn-icon like-btn liked" data-song-id="<%= song._id %>" data-liked="true">
            <i class="fas fa-heart"></i>
          </button>
          <span class="song-row-duration"><%= song.formattedDuration %></span>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <i class="far fa-heart"></i>
      <h2>Songs you like will appear here</h2>
      <p>Save songs by tapping the heart icon.</p>
      <a href="/" class="btn btn-accent">Find Songs</a>
    </div>
  <% } %>
</section>
